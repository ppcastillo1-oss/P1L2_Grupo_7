build/

# ============================================================
#  Unity — cache regenerable
# ============================================================
# El 99,97% del proyecto (40.000 archivos, ~2 GB) es cache que Unity
# reconstruye sola al abrir. Solo se versionan Assets, ProjectSettings
# y Packages: 73 archivos, 0,3 MB.
Library/
Temp/
Obj/
obj/
Build/
Builds/
Logs/
UserSettings/
MemoryCaptures/
Recordings/
*.csproj
*.sln
*.slnx
*.unityproj
*.userprefs
.idea/
# Lo que genera Unity sola dentro del proyecto (no la config del repo,
# que si se versiona: ver .vscode/settings.json en la raiz)
unity/.vscode/
sysinfo.txt
*.apk
*.aab
*.unitypackage

# ============================================================
#  Sistema y sueltos
# ============================================================
Thumbs.db
desktop.ini
.DS_Store

# Artefactos que genera sola la Test Framework de Unity al compilar
unity/Assets/Resources/PerformanceTestRunInfo.json*
unity/Assets/Resources/PerformanceTestRunSettings.json*
Sin*título*.png

# Snapshot viejo de estos mismos archivos; el repo es la fuente de verdad
laboratorio_estructural.zip
